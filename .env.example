# Copier en .env et remplir. Ne jamais versionner le .env.

NODE_ENV=development
PORT=5000

# Base de données
MONGODB_URI=mongodb://127.0.0.1:27017/adlam

# Authentification (secret long et aléatoire, ex : openssl rand -hex 32)
JWT_SECRET=
JWT_EXPIRES_IN=30d

# Origines front supplémentaires autorisées par CORS, séparées par des virgules
CORS_ORIGINS=

# Cloudinary
CLOUDINARY_CLOUDNAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Paiement Stripe (laisser vide pour désactiver)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# true = paiements simulés acceptés sans encaissement. Uniquement pour les tests, jamais en production.
PAYMENT_SIMULATION=false

# Utilisés uniquement par create-admin.js
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
